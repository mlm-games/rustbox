# Maintainer: mlm-games
pkgname=rustbox
pkgver=0.2.0
pkgrel=1
pkgdesc="3D level builder"
arch=('x86_64')
url="https://github.com/mlm-games/rustbox"
license=('GPL3')
depends=('alsa-lib' 'libx11' 'libxcb' 'wayland')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::https://github.com/mlm-games/rustbox/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cargo build --release
}

package() {
    install -Dm755 target/release/rustbox-desktop "$pkgdir/usr/bin/$pkgname-desktop"
}
