# Maintainer: mlm-games
pkgname=my-ecosystem-bevy
pkgver=0.1.0
pkgrel=1
pkgdesc="Clone of my Godot template for bevy"
arch=('x86_64')
url="https://github.com/mlm-games/my-ecosystem-bevy"
license=('GPL3')
depends=('alsa-lib' 'libx11' 'libxcb' 'wayland')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::https://github.com/mlm-games/my-ecosystem-bevy/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cargo build --release
}

package() {
    install -Dm755 target/release/$pkgname "$pkgdir/usr/bin/$pkgname"
}
